# ──────────────────────────────────────────────────────────────
# CodeLens – Environment Variables Example
# Copy this file to .env.local and fill in your Groq API key.
# ──────────────────────────────────────────────────────────────

# ── Groq Cloud API (REQUIRED) ─────────────────────────────────
# Get your free API key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Groq model to use for code analysis.
# Recommended: llama-3.3-70b-versatile (fast + capable)
# Alternatives: llama-3.1-70b-versatile, llama3-70b-8192, llama3-8b-8192
GROQ_MODEL=llama-3.3-70b-versatile

# ── Application Settings ──────────────────────────────────────
# Maximum file upload size in megabytes
MAX_UPLOAD_SIZE_MB=5

# ── Authentication ─────────────────────────────────────────────
# Change this to a long random string in production!
JWT_SECRET_KEY=codelens-super-secret-jwt-key-change-in-prod-2026

# Token expiry in minutes (default: 7 days)
ACCESS_TOKEN_EXPIRE_MINUTES=10080

